# Copy to .env and fill in. Names only here; never commit real values.
# Script model. Fill the pair that matches llm.provider in config/models.yaml.
ANTHROPIC_API_KEY=
# For llm.provider: azure_openai. Endpoint from Foundry > your resource > Overview,
# e.g. https://videopipe-ai.openai.azure.com (the /openai/v1/ part is added for you).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Voice: fill the one that matches tts.provider in config/models.yaml.
#   azure      -> AZURE_SPEECH_KEY + AZURE_SPEECH_REGION
#   elevenlabs -> ELEVENLABS_API_KEY (most human-sounding; Starter plan or higher for commercial use)
#   openai     -> OPENAI_API_KEY (gpt-4o-mini-tts, about $0.015 a minute)
#   kokoro     -> nothing; free model files on disk (KOKORO_DIR)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# The If Lab's painted look uses ElevenLabs (config/styles/iflab.yaml). elevenlabs.io > Profile > API key.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OPENAI_TTS_INSTRUCTIONS="Speak like ..."   # overrides the default narrator direction
# KOKORO_DIR=~/.cache/videopipe/kokoro
# Only needed when stills are enabled (visuals.stills: true in the channel file)
OPENAI_API_KEY=

# Optional
# PIPELINE_CHROME=/path/to/chrome-or-chromium   # use an installed Chrome instead of Remotion's download
# PIPELINE_DB_URL=sqlite:///pipeline.db
# RENDER_CONCURRENCY=4
# PIPELINE_CHECKPOINT_DB=/path/to/checkpoints.db   # where resume checkpoints live (default: project root)
